// Shawshank Cell Block C — dual examine/talk hotspots on Andy's cell.
// Host gates (adventure example-08 FlagHost::hotspot_active), aligned with
// ncp/demos/shawshank-pac HTML smoke:
//   hs_red_cell          always
//   hs_andy_cell         always (empty vs occupied handled in action)
//   hs_andy_cell_talk    only when CanTalkAndy (after Look on occupied cell)
//   hs_contraband_spot   only when KnowsRedBusiness (after first-meeting dialog)
// Spine: ExaminedCell → AndyArrived (N) → Noticed/CanTalk → Met/KnowsRed → stone
//
// Polygons are calibrated to the 1280×720 `cellblock_bg.png` door bars
// (y-down norm), NOT the legacy NCP 2560×1080 scroll bounds — those sat
// on the mid-corridor pillar and did not match the art.
(
    name: "shawshank_cellblock",
    entry_room: "cellblock_c",
    rooms: {
        "cellblock_c": (
            id: "cellblock_c",
            background: 15242913048759617436,
            walk_graph: (
                nodes: [],
                edges: [],
            ),
            hotspots: [
                (
                    // Red — upper door face (portrait-sized click target).
                    id: "hs_red_cell",
                    kind: Examine,
                    polygon: [
                        (0.055, 0.28),
                        (0.145, 0.28),
                        (0.145, 0.48),
                        (0.055, 0.48),
                    ],
                    cursor: Named("look"),
                    on_click: (
                        kind: Action,
                        id: "examine_red_cell",
                    ),
                ),
                (
                    // Andy — second door face (not the full pillar).
                    id: "hs_andy_cell",
                    kind: Examine,
                    polygon: [
                        (0.232, 0.26),
                        (0.292, 0.26),
                        (0.292, 0.44),
                        (0.232, 0.44),
                    ],
                    cursor: Named("look"),
                    on_click: (
                        kind: Action,
                        id: "examine_andy_cell",
                    ),
                ),
                (
                    // Talk — same face geometry as examine; host-hidden until can_talk.
                    id: "hs_andy_cell_talk",
                    kind: Talk,
                    polygon: [
                        (0.232, 0.26),
                        (0.292, 0.26),
                        (0.292, 0.44),
                        (0.232, 0.44),
                    ],
                    cursor: Named("talk"),
                    on_click: (
                        kind: Action,
                        id: "talk_andy",
                    ),
                ),
                (
                    // Loose stone at the base of Red's door bars.
                    id: "hs_contraband_spot",
                    kind: Use,
                    polygon: [
                        (0.078, 0.575),
                        (0.122, 0.575),
                        (0.122, 0.625),
                        (0.078, 0.625),
                    ],
                    cursor: Named("use"),
                    on_click: (
                        kind: Action,
                        id: "use_loose_stone",
                    ),
                ),
            ],
            props: [],
            spawns: {
                "entry": (
                    id: "entry",
                    point: (0.2, 0.85),
                    facing: East,
                    depth: 0.0,
                ),
            },
            ambient_music: None,
            ambient_sfx: None,
        ),
    },
    transitions: {},
)
